<mvc:View
    controllerName="ui5.tutorial.walkthrough.controller.App"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
>
    <Text text="Hola Mundo!" />
    <Button
        text="Say Hello"
        press=".onShowHello"
    />
    <Input value="{/recipient/name}"
    description="Hola {/recipient/name}" 
    valueLiveUpdate="true"
    width="60%" />
</mvc:View>
