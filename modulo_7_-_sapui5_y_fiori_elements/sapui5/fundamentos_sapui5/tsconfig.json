{
    "compilerOptions": {
        "target": "es2023",
        "module": "es2022",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "allowJs": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "rootDir": "./webapp",
        "types": ["@openui5/types"],
        "paths": {
            "ui5/tutorial/walkthrough/*": ["./webapp/*"]
        }
    },
    "include": ["./webapp/**/*"]
}
